. 
. *----------------------------------------------------------------------------
> --
. *  5. 样本限制（论文 Appendix Table 1 注释）
. *     男性户主、15-65 岁、有有效工资记录
. *----------------------------------------------------------------------------
> --
. keep if relate == 1 & sex == 1 & age >= 15 & age <= 65
(583,784 observations deleted)

. keep if incwage > 0 & incwage < 9999990
(84,853 observations deleted)

. 
. quietly count

. local N = r(N)

. 
. *----------------------------------------------------------------------------
> --
. *  6. 构造指标
. *----------------------------------------------------------------------------
> --
. gen byte moved  = (geo_key != bpl_key)

. label var moved "迁移：现居县 != 出生县"

. 
. gen byte okA    = !missing(oA) & !missing(dA)

. gen byte okB    = !missing(oB) & !missing(dB)

. gen byte sameA  = (oA == dA) if moved == 1
(30,421 missing values generated)

. gen byte sameB  = (oB == dB) if moved == 1
(30,421 missing values generated)

. 
. gen double wmoved = perwt*moved

. gen double wsameA = perwt*sameA
(30,421 missing values generated)

. gen double wsameB = perwt*sameB
(30,421 missing values generated)

. 
. *----------------------------------------------------------------------------
> --
. *  7. 计算结果：迁移率 与 同类内迁移占比
. *     迁移率的 Rural/Urban 分组依赖城乡划分规则，故规则 A、B 下均报告；
. *     All 列不受划分规则影响。
. *----------------------------------------------------------------------------
> --
. matrix RES = J(6, 3, .)

. matrix colnames RES = Rural Urban All

. matrix rownames RES = "Migrate_A" "Within_A" "Migrate_B" "Within_B" "PaperMig
> rate" "PaperWithin"

. 
. foreach rl in A B {
  2.     local oc  "o`rl'"
  3.     local okc "ok`rl'"
  4.     local sc  "wsame`rl'"
  5. 
.     local mr = .
  6.     local mu = .
  7.     local ma = .
  8.     local wr = .
  9.     local wu = .
 10.     local wa = .
 11. 
.     forvalues k = 1/3 {
 12.         local sel ""
 13.         if `k' == 2 local sel " & `oc' == 1"
 14.         if `k' == 3 local sel " & `oc' == 0"
 15. 
.         * 迁移率：分母为全部样本，分子为迁移者
.         quietly summarize perwt if 1`sel'
 16.         local den = r(sum)
 17.         quietly summarize wmoved if 1`sel'
 18.         local mv = r(sum)/`den'*100
 19. 
.         * 同类内迁移占比：分母为可分类的迁移者，分子为迁往同类县者
.         quietly summarize perwt if moved == 1 & `okc'`sel'
 20.         local den2 = r(sum)
 21.         quietly summarize `sc' if moved == 1 & `okc'`sel'
 22.         local wv = r(sum)/`den2'*100
 23. 
.         if `k' == 1 {
 24.             local ma = `mv'
 25.             local wa = `wv'
 26.         }
 27.         if `k' == 2 {
 28.             local mr = `mv'
 29.             local wr = `wv'
 30.         }
 31.         if `k' == 3 {
 32.             local mu = `mv'
 33.             local wu = `wv'
 34.         }
 35.     }
 36. 
.     if "`rl'" == "A" {
 37.         matrix RES[1,1] = `mr'
 38.         matrix RES[1,2] = `mu'
 39.         matrix RES[1,3] = `ma'
 40.         matrix RES[2,1] = `wr'
 41.         matrix RES[2,2] = `wu'
 42.         matrix RES[2,3] = `wa'
 43.     }
 44.     else {
 45.         matrix RES[3,1] = `mr'
 46.         matrix RES[3,2] = `mu'
 47.         matrix RES[3,3] = `ma'
 48.         matrix RES[4,1] = `wr'
 49.         matrix RES[4,2] = `wu'
 50.         matrix RES[4,3] = `wa'
 51.     }
 52. }

. 
. * 论文 Table 1 报告的 1995 年数值
. matrix RES[5,1] = 32.3

. matrix RES[5,2] = 35.8

. matrix RES[5,3] = 33.7

. matrix RES[6,1] = 31.1

. matrix RES[6,2] = 74.6

. matrix RES[6,3] = 49.4

. 
. *----------------------------------------------------------------------------
> --
. *  8. 输出
. *----------------------------------------------------------------------------
> --
. quietly count

. local N = r(N)

. quietly count if moved == 1

. local Nmig = r(N)

. quietly count if moved == 1 & !okA

. local Ndrop = r(N)

