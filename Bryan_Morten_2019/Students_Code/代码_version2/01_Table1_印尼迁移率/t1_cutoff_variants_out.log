.     display "  实现                                  切点     农村县  城市县   农村县人口占比"
  实现                                  切点     农村县  城市县   农村县人口占比

.     display "  " "{hline 84}"
  ------------------------------------------------------------------------------------

. 
.     local names `" "V1 累计人口法(跨线县不计入)" "V2 累计人口法(跨线县计入)" "V3 直接阈值法(cut=全国农村占比)" "V4 匹配城镇侧(城市县37.31%)" "VB 中位数法(脚注3/规则B)" "'

.     local vars  "rA1 rA2 rA3 rA4 rB_"

.     local cuts  "`CUT1' `CUT1' `CUT3' `CUT4' `CUTB'"

.     forvalues i = 1/5 {
  2.         local v  : word `i' of `vars'
  3.         local nm : word `i' of `names'
  4.         local ct : word `i' of `cuts'
  5.         quietly count if `v' == 1
  6.         local nR = r(N)
  7.         quietly summarize wpop if `v' == 1
  8.         local pR = r(sum)/`tp'*100
  9.         display "  `nm'  " %7.4f `ct' "  " %5.0f `nR' "   " %5.0f `nc'-`nR' "   " %8.2f `pR' "%"
 10.     }
