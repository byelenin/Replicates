. 
. tempfile panelmain tauobs o17 d17

. matrix RESULTS = J(3, 8, .)

. local rowi = 0

. 
. foreach TH of numlist 4.0869 12.4399 12.5836 {
  2.     local rowi = `rowi' + 1
  3.     display _n(2) "{hline 78}"
  4.     display "  θ = `TH'   （第 `rowi' 套）"
  5.     display "{hline 78}"
  6. 
.     * 上一轮保存的 panelmain 里已含这些变量，先清掉
.     capture drop w_d
  7.     capture drop q_o
  8.     capture drop lhs_sym
  9.     capture drop tau_obs
 10.     capture drop Zg
 11.     capture drop alpha_d
 12.     capture drop phat
 13.     capture drop tau_full
 14.     capture drop tau_use
 15. 
.     * ---- (a) 式(7) IV ----
.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
 16.     quietly predict double phat, xb
 17.     quietly ivregress 2sls ln_wage (ln_p = phat) i.o i.d, cluster(o)
 18.     display "  式(7) 自己估出的 θ = " %8.4f -1/_b[ln_p] "   （本次强制 θ = `TH'）"
 19.     quietly summarize wage_od
 20.     local v = r(Var)/(r(mean)^2)
 21.     local best = .
 22.     local bestd = 1e30
 23.     forvalues i = 205/4000 {
 24.         local tt = `i'/100
 25.         local rhs = exp(lngamma(1 - 2/`tt'))/(exp(lngamma(1 - 1/`tt'))^2) - 1
 26.         if abs(`rhs' - `v') < `bestd' {
 27.             local bestd = abs(`rhs' - `v')
 28.             local best = `tt'
 29.         }
 30.     }
 31.     local ttilde = `best'
 32.     display "  θ̃ = " %8.4f `ttilde' "   Γ̄ = Γ(1−1/θ̃) = " %10.6f exp(lngamma(1 - 1/`ttilde'))
 33. 
.     * ---- w_d（按目的地 16 个）----
.     quietly gen double w_d = .
 34.     forvalues i = 1/`ND' {
 35.         local cc : word `i' of `dlist'
 36.         if `cc' == `=DLIST[1,1]' local g = 0
 37.         else {
 38.             capture local g = _b[`cc'.d]
 39.             if _rc local g = .
 40.         }
 41.         quietly replace w_d = exp(_b[_cons] + `g' - lngamma(1 - 1/`ttilde')) if d == `cc'
 42.     }
 43.     quietly summarize w_d
 44.     display "  w_d：最小 = " %12.1f r(min) "   最大 = " %12.1f r(max) "   非缺失 = " %4.0f r(N)
 45. 
.     * ---- q_o（按出发地 17 个）----
.     quietly gen double q_o = .
 46.     forvalues i = 1/`NO' {
 47.         local cc : word `i' of `olist'
 48.         if `cc' == `=OLIST[1,1]' local h = 0
 49.         else {
 50.             capture local h = _b[`cc'.o]
 51.             if _rc local h = .
 52.         }
 53.         quietly replace q_o = exp(`h') if o == `cc'
 54.     }
 55.     quietly summarize q_o
 56.     display "  q_o：最小 = " %8.4f r(min) "   最大 = " %8.4f r(max) "   非缺失 = " %4.0f r(N)
 57. 
.     * ---- (b) τ(θ) ----
.     quietly gen double lhs_sym = (ln_p - ln_poo) + (ln_p_rev - ln_pdd)
 58.     quietly gen double tau_obs = 1 - exp(lhs_sym/(2*`TH'))
 59.     quietly summarize tau_obs
 60.     display "  τ（可算格子）：均值 = " %8.4f r(mean) "  范围 [" %8.4f r(min) ", " %8.4f r(max) "]  N = " %4.0f r(N)
 61. 
.     * ---- (c) α_d(θ) ----
.     quietly gen double Zg = ln_p - `TH'*ln(w_d) - lhs_sym/2
 62.     quietly regress Zg i.d i.o
 63.     local refd = .
 64.     capture local refd = _b[`=DLIST[1,1]'.d]
 65.     if _rc local refd = 0
 66.     quietly gen double alpha_d = .
 67.     forvalues i = 1/`ND' {
 68.         local cc : word `i' of `dlist'
 69.         if `cc' == `=DLIST[1,1]' local g = 0
 70.         else {
 71.             capture local g = _b[`cc'.d]
 72.             if _rc local g = .
 73.         }
 74.         quietly replace alpha_d = exp((`g' - `refd')/`TH') if d == `cc'
 75.     }
 76.     quietly summarize alpha_d
 77.     display "  α_d：最小 = " %8.4f r(min) "   最大 = " %8.4f r(max) "   非缺失 = " %4.0f r(N)
 78. 
.     * ---- (d) 组装向量 ----
.     tempname W AL QQ LO
 79.     matrix `W'  = J(1, `ND', .)
 80.     matrix `AL' = J(1, `ND', .)
 81.     matrix `QQ' = J(1, `NO', .)
 82.     matrix `LO' = J(1, `NO', .)
 83.     forvalues i = 1/`ND' {
 84.         local cc : word `i' of `dlist'
 85.         quietly summarize w_d if d == `cc'
 86.         matrix `W'[1, `i']  = r(mean)
 87.         quietly summarize alpha_d if d == `cc'
 88.         matrix `AL'[1, `i'] = r(mean)
 89.     }
 90.     forvalues i = 1/`NO' {
 91.         local cc : word `i' of `olist'
 92.         quietly summarize q_o if o == `cc'
 93.         matrix `QQ'[1, `i'] = r(mean)
 94.         quietly summarize pop_o if o == `cc'
 95.         matrix `LO'[1, `i'] = r(mean)
 96.     }
 97. 
.     * ---- (e) 17×16 网格上的 τ ----
.     quietly save `panelmain', replace
 98.     keep o d tau_obs
 99.     save `tauobs', replace
100.     use `panelmain', clear
101.     keep o
102.     duplicates drop
103.     rename o oo
104.     sort oo
105.     save `o17', replace
106.     use `panelmain', clear
107.     keep d
108.     duplicates drop
109.     rename d dd
110.     sort dd
111.     save `d17', replace
112. 
.     use `o17', clear
113.     cross using `d17'
114.     rename oo o
115.     rename dd d
116.     sort o d
117.     display "  完整 OD 网格：" _N " 格"
118.     merge 1:1 o d using `tauobs', keep(master match) nogen
119.     quietly count if !missing(tau_obs)
120.     display "  其中 τ 可观测：" r(N)
121.     quietly regress tau_obs i.o i.d
122.     quietly predict double tau_full, xb
123.     quietly replace tau_full = 0 if o == d
124.     quietly count if missing(tau_full)
125.     display "  插值后仍缺失：" r(N)
126.     sort o d
127.     mkmat tau_full, matrix(TAUF)
128.     display "  τ_full 行数 = " rowsof(TAUF) "  （应为 `NO'×`ND' = `=`NO'*`ND''）"
129. 
.     * ---- (f) Mata ----
.     mata: table5_do(`TH', st_matrix("`W'"), st_matrix("`AL'"), st_matrix("`QQ'"), st_matrix("`LO'"), rowshape(st_matrix("TAUF"), `NO'))
130.     forvalues j = 1/8 {
131.         matrix RESULTS[`rowi', `j'] = ROWOUT[1, `j']
132.     }
133. 
.     use `panelmain', clear
134. }


