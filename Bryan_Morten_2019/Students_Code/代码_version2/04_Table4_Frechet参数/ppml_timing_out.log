. *==============================================================================
. * 7. 实测：跑 B=20 轮 bootstrap，量出每轮真实耗时
. *==============================================================================
. display _n(2) "===== 7. 实测 bootstrap 速度（B=20）====="


===== 7. 实测 bootstrap 速度（B=20）=====

. 
. local Btest = 20

. set seed 20191029

. 
. capture program drop boottime

. program define boottime
  1.     args cl Btest
  2.     timer clear 5
  3.     timer on 5
  4.     forvalues b = 1/`Btest' {
  5.         preserve
  6.         quietly bsample, cluster(`cl') idcluster(bsid2)
  7.         quietly capture onepass
  8.         restore
  9.     }
 10.     timer off 5
 11. end

. 
. foreach cc in id us {
  2.     if "`cc'" == "id" {
  3.         use `idpanel', clear
  4.         local lab "印尼"
  5.     }
  6.     if "`cc'" == "us" {
  7.         use `uspanel', clear
  8.         local lab "美国"
  9.     }
 10.     quietly boottime o `Btest'
 11.     display "  ── `lab' 跑完 `Btest' 轮 bootstrap，计时器 5 显示："
 12.     timer list 5
 13.     display "  ── `lab' 结束"
 14. }
