. *==============================================================================
. * 5. 定义一次完整估计（θ 和 ρ）
. *==============================================================================
. capture program drop onepass

. program define onepass, rclass
  1.     capture drop phat
  2.     capture drop u
  3.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
  4.     quietly predict double phat, xb
  5.     quietly capture reghdfe ln_p phat, absorb(o d) residuals(u)
  6.     if _rc != 0 {
  7.         return scalar theta = .
  8.         return scalar thetat = .
  9.         return scalar rho = .
 10.         exit
 11.     }
 12.     quietly capture ppmlhdfe wage_od ln_p u, absorb(o d)
 13.     if _rc != 0 {
 14.         return scalar theta = .
 15.         return scalar thetat = .
 16.         return scalar rho = .
 17.         exit
 18.     }
 19.     local beta = _b[ln_p]
 20.     if `beta' >= 0 {
 21.         return scalar theta = .
 22.         return scalar thetat = .
 23.         return scalar rho = .
 24.         exit
 25.     }
 26.     local theta = -1/`beta'
 27. 
.     quietly summarize wage_od
 28.     local V = r(Var)/r(mean)^2
 29.     local best = .
 30.     local bestv = .
 31.     forvalues i = 205/3000 {
 32.         local tt = `i'/100
 33.         local rhs = exp(lngamma(1-2/`tt'))/(exp(lngamma(1-1/`tt'))^2) - 1
 34.         local df = abs(`rhs' - `V')
 35.         if `bestv' == . | `df' < `bestv' {
 36.             local bestv = `df'
 37.             local best = `tt'
 38.         }
 39.     }
 40.     local c0 = `best' - 0.05
 41.     local bestv = .
 42.     forvalues i = 0/100 {
 43.         local tt = `c0' + `i'*0.001
 44.         if `tt' > 2 {
 45.             local rhs = exp(lngamma(1-2/`tt'))/(exp(lngamma(1-1/`tt'))^2) - 1
 46.             local df = abs(`rhs' - `V')
 47.             if `bestv' == . | `df' < `bestv' {
 48.                 local bestv = `df'
 49.                 local best = `tt'
 50.             }
 51.         }
 52.     }
 53.     return scalar theta  = `theta'
 54.     return scalar thetat = `best'
 55.     return scalar rho    = 1 - `best'/`theta'
 56. end

. 
