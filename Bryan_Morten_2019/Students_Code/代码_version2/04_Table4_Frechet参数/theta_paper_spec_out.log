. *==============================================================================
. * 4. 子程序：给定 m_od 建完整估计样本
. *==============================================================================
. capture program drop buildpanel

. program define buildpanel
  1.     args distf out
  2.     * 输入数据集须含：o d m_od wage_od n_raw n_wage
.     quietly {
  3.         bysort o: egen double pop_o  = total(m_od)
  4.         bysort d: egen double m_in_d = total(m_od)
  5.         egen double pop_all = total(m_od)
  6.         gen double pi_do = m_od/pop_o
  7.     }
  8. 
.     preserve
  9.         keep if o == d
 10.         keep o pi_do
 11.         rename pi_do pi_oo
 12.         tempfile go
 13.         save `go'
 14.         rename o d
 15.         rename pi_oo pi_dd
 16.         tempfile gd
 17.         save `gd'
 18.     restore
 19. 
.     preserve
 20.         keep o d pi_do
 21.         rename o _t1
 22.         rename d _t2
 23.         rename _t1 d
 24.         rename _t2 o
 25.         rename pi_do pi_rev
 26.         tempfile rv
 27.         save `rv'
 28.     restore
 29. 
.     gen double pi_dnoto = (m_in_d - m_od)/(pop_all - pop_o) if (pop_all - pop_o) > 0
 30. 
.     keep if o != d
 31.     merge m:1 o using `go', keep(master match) nogen
 32.     merge m:1 d using `gd', keep(master match) nogen
 33.     merge 1:1 o d using `rv', keep(master match) nogen
 34.     merge 1:1 o d using `distf', keep(master match) nogen
 35. 
.     keep if !missing(pi_do) & pi_do > 0
 36.     keep if !missing(pi_rev) & pi_rev > 0
 37.     keep if !missing(pi_oo) & pi_oo > 0
 38.     keep if !missing(pi_dd) & pi_dd > 0
 39.     keep if !missing(pi_dnoto) & pi_dnoto > 0
 40.     keep if !missing(dist_km) & dist_km > 0
 41.     keep if !missing(wage_od) & wage_od > 0
 42. 
.     gen double ln_p      = ln(pi_do)
 43.     gen double ln_p_rev  = ln(pi_rev)
 44.     gen double ln_poo    = ln(pi_oo)
 45.     gen double ln_pdd    = ln(pi_dd)
 46.     gen double ln_pdnoto = ln(pi_dnoto)
 47.     gen double ln_wage   = ln(wage_od)
 48.     save `out', replace
 49. end

. 
. *==============================================================================
. * 5. 子程序：估 θ（PPML+控制函数IV）与 ρ（式 8），可加格子筛选
. *==============================================================================
. capture program drop estppml

. program define estppml
  1.     args tag cl nmin rawvar
  2.     * nmin=0 表示不筛选
.     if `nmin' > 0 {
  3.         quietly drop if `rawvar' < `nmin'
  4.     }
  5.     quietly count
  6.     local ncell = r(N)
  7.     quietly count if !missing(wage_od)
  8.     local nreg = r(N)
  9. 
.     if `ncell' < 10 {
 10.         display "  `tag'：样本太小，跳过"
 11.         exit
 12.     }
 13. 
.     * --- θ：零阶段 ---
.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
 14.     local r2z = e(r2)
 15.     quietly predict double phat, xb
 16. 
.     * --- θ：PPML + 双向 FE + 控制函数 ---
.     quietly capture reghdfe ln_p phat, absorb(o d) residuals(u)
 17.     if _rc != 0 {
 18.         display "  `tag'：第一阶段失败 rc=`=_rc'"
 19.         exit
 20.     }
 21.     quietly capture ppmlhdfe wage_od ln_p u, absorb(o d) cluster(`cl')
 22.     if _rc != 0 {
 23.         display "  `tag'：PPML 失败 rc=`=_rc'"
 24.         exit
 25.     }
 26.     local beta = _b[ln_p]
 27.     if `beta' >= 0 {
 28.         display "  `tag'：β 为正，θ 无解"
 29.         exit
 30.     }
 31.     local theta = -1/`beta'
 32. 
.     * --- ρ：式(8) 两阶段网格搜索（老师口径：组内 CV^2，按人口加权） ---
.     quietly summarize cv2_in [aw = npw]
 33.     local V = r(mean)
 34.     local best = .
 35.     local bestv = .
 36.     forvalues i = 205/3000 {
 37.         local tt = `i'/100
 38.         local rhs = exp(lngamma(1-2/`tt'))/(exp(lngamma(1-1/`tt'))^2) - 1
 39.         local d = abs(`rhs' - `V')
 40.         if `bestv' == . | `d' < `bestv' {
 41.             local bestv = `d'
 42.             local best = `tt'
 43.         }
 44.     }
 45.     local c0 = `best' - 0.05
 46.     local c1 = `best' + 0.05
 47.     local bestv = .
 48.     forvalues i = 0/100 {
 49.         local tt = `c0' + `i'*0.001
 50.         if `tt' > 2 {
 51.             local rhs = exp(lngamma(1-2/`tt'))/(exp(lngamma(1-1/`tt'))^2) - 1
 52.             local d = abs(`rhs' - `V')
 53.             if `bestv' == . | `d' < `bestv' {
 54.                 local bestv = `d'
 55.                 local best = `tt'
 56.             }
 57.         }
 58.     }
 59.     local thetat = `best'
 60.     local rho = 1 - `thetat'/`theta'
 61. 
.     display "  `tag'"
 62.     display "      样本：`ncell' 个 OD 对（其中 `nreg' 个有工资）   零阶段 R² = " %6.4f `r2z'
 63.     display "      θ  = " %8.4f `theta' "        θ̃ = " %7.4f `thetat' "        ρ = " %7.4f `rho'
 64.     display "      var(w)/w̄² = " %8.5f `V'
 65. end

. 
