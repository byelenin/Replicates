. * ============================================================
. * 估计程序：返回 theta / rho / thetat
. * ============================================================
. capture program drop thetaonly

. program define thetaonly, rclass
  1.     * 零阶段
.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
  2.     quietly predict double _ph, xb
  3.     * 第二阶段 IV
.     quietly capture ivregress 2sls ln_wage (ln_p = _ph) i.o i.d, cluster(o)
  4.     if _rc {
  5.         quietly ivregress 2sls ln_wage (ln_p = _ph) i.o i.d
  6.     }
  7.     local b = _b[ln_p]
  8.     if `b' >= 0 {
  9.         return scalar theta = .
 10.         return scalar N     = e(N)
 11.         exit
 12.     }
 13.     local theta = -1/`b'
 14.     return scalar theta = `theta'
 15.     return scalar N     = e(N)
 16. 
.     * 式 (8)：用组内工资方差估 theta-tilde
.     quietly summarize wage_od
 17.     local wbar = r(mean)
 18.     quietly summarize wage_od
 19.     local wvar = r(Var)
 20.     local vm   = `wvar'/(`wbar'^2)
 21. 
.     local best = .
 22.     local bezt = .
 23.     forvalues tt = 200/3000 {
 24.         local t = `tt'/100
 25.         local g1 = lngamma(1 - 1/`t')
 26.         local g2 = lngamma(1 - 2/`t')
 27.         if `g2' < . {
 28.             local pred = exp(`g2' - 2*`g1') - 1
 29.             local d = abs(`pred' - `vm')
 30.             if `best' == . | `d' < `best' {
 31.                 local best = `d'
 32.                 local bezt = `t'
 33.             }
 34.         }
 35.     }
 36.     forvalues tt = -50/50 {
 37.         local t = `bezt' + `tt'/1000
 38.         if `t' > 2 {
 39.             local g1 = lngamma(1 - 1/`t')
 40.             local g2 = lngamma(1 - 2/`t')
 41.             if `g2' < . {
 42.                 local pred = exp(`g2' - 2*`g1') - 1
 43.                 local d = abs(`pred' - `vm')
 44.                 if `d' < `best' {
 45.                     local best = `d'
 46.                     local bezt = `t'
 47.                 }
 48.             }
 49.         }
 50.     }
 51.     return scalar thetat = `bezt'
 52.     return scalar rho    = 1 - `bezt'/`theta'
 53.     return scalar vm     = `vm'
 54. end

