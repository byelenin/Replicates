. * ============================================================
. * 用两种 pi 分别估 theta
. * ============================================================
. capture program drop estpi

. program define estpi, rclass
  1.     args pv
  2.     capture drop _ph
  3.     quietly regress `pv' c.ln_pdnoto##c.ln_pdnoto
  4.     quietly predict double _ph, xb
  5.     quietly capture ivregress 2sls ln_wage (`pv' = _ph) i.o i.d, cluster(o
> )
  6.     if _rc {
  7.         quietly ivregress 2sls ln_wage (`pv' = _ph) i.o i.d
  8.     }
  9.     local b = _b[`pv']
 10.     return scalar N = e(N)
 11.     if `b' >= 0 {
 12.         return scalar theta = .
 13.         exit
 14.     }
 15.     return scalar theta = -1/`b'
 16. end

