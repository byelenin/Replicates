. use year bplid geo1_id incwage perwt relate sex age using "`root'\ipumsi_0000
> 2.dta", clear

. keep if year == 1995
(23,603,049 observations deleted)

. keep if sex == 1 & relate == 1 & inrange(age, 15, 65)
(583,784 observations deleted)

