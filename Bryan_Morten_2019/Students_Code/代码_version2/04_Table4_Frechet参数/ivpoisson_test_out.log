. *==============================================================================
. * 正式测试
. *==============================================================================
. foreach cc in id us {
  2.     if "`cc'" == "id" {
  3.         use `idpanel', clear
  4.         local lab "印尼 1995"
  5.         local pobj "论文 θ = 12.5"
  6.     }
  7.     if "`cc'" == "us" {
  8.         use `uspanel', clear
  9.         local lab "美国 1990"
 10.         local pobj "论文 θ = 27.6"
 11.     }
 12. 
.     display _n(2) "{hline 80}"
 13.     display "  `lab'      （`pobj'）"
 14.     display "{hline 80}"
 15. 
.     quietly count
 16.     display "  OD 对数：`r(N)'"
 17. 
.     * 零阶段
.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
 18.     display "  零阶段 R² = " %6.4f e(r2)
 19.     quietly predict double phat, xb
 20. 
.     * ---------- 方法甲：控制函数法（两步）----------
.     timer clear 1
 21.     timer on 1
 22.     quietly capture reghdfe ln_p phat, absorb(o d) residuals(u)
 23.     if _rc == 0 {
 24.         quietly capture ppmlhdfe wage_od ln_p u, absorb(o d) cluster(o)
 25.         if _rc == 0 {
 26.             local bA = _b[ln_p]
 27.         }
 28.         else {
 29.             local bA = .
 30.         }
 31.     }
 32.     else {
 33.         local bA = .
 34.     }
 35.     timer off 1
 36.     display _n "  【甲】控制函数法：reghdfe + ppmlhdfe 两步"
 37.     timer list 1
 38.     if `bA' != . & `bA' < 0 {
 39.         display "      θ = " %8.4f -1/`bA'
 40.     }
 41.     else {
 42.         display "      失败或 β 为正"
 43.     }
 44. 
.     * ---------- 方法乙：ivpoisson gmm（一步到位，固定效应当回归元）----------
.     timer clear 2
 45.     timer on 2
 46.     capture noisily ivpoisson gmm wage_od (ln_p = phat) i.o i.d
 47.     local rcB = _rc
 48.     timer off 2
 49.     display _n "  【乙】ivpoisson gmm：PPML + IV + GMM + 固定效应虚拟变量"
 50.     display "      返回码 = `rcB'"
 51.     timer list 2
 52.     if `rcB' == 0 {
 53.         local bB = _b[ln_p]
 54.         if `bB' < 0 {
 55.             display "      θ = " %8.4f -1/`bB'
 56.         }
 57.         else {
 58.             display "      β 为正，θ 无解"
 59.         }
 60.     }
 61. }


