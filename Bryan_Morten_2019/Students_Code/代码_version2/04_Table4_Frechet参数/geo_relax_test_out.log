. foreach s in "A `pa'" "B `pb'" {
  2.     local tag : word 1 of `s'
  3.     local f   : word 2 of `s'
  4.     use `f', clear
  5.     quietly count
  6.     local n = r(N)
  7.     quietly levelsof o, local(OL)
  8.     local no : word count `OL'
  9.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
 10.     quietly predict double phat, xb
 11.     capture quietly ivregress 2sls ln_wage (ln_p = phat) i.o i.d
 12.     if _rc == 0 {
 13.         local th = -1/_b[ln_p]
 14.         display "  设定 `tag'        `no'      `n'      " %8.4f `th'
 15.     }
 16.     else {
 17.         display "  设定 `tag'  回归失败 rc = " _rc
 18.     }
 19.     capture drop phat
 20. }
