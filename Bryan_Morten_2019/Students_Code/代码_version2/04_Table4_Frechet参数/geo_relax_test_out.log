file C:\Users\任娜\AppData\Local\Temp\ST_3d84_000001.tmp saved as .dta format

. global DIST25 "`dist25'"

. display "  省级距离表：25 省的 " _N " 个 OD 对"
  省级距离表：25 省的 625 个 OD 对

. 
. *------------------------------------------------------------------------------
. * 建面板的子程序（参数 1 = 是否也限制 o）
. *------------------------------------------------------------------------------
. capture program drop buildpanel

. program define buildpanel
  1.     args restrictO
  2.     local dist25x "$DIST25"
  3.     use year bplid geo1_id incwage perwt relate sex age using "$ROOT\ipumsi_00002.dta", clear
  4.     keep if year == 1995
  5.     keep if sex == 1 & relate == 1 & inrange(age, 15, 65)
  6.     gen int o = bplid
  7.     gen int d = geo1_id - 360000
  8.     * d：现居地本来就只有这 17 个省
.     keep if inrange(d, 11, 18) | inrange(d, 31, 35) | inrange(d, 51, 54)
  9.     if `restrictO' == 1 {
 10.         * 现状：对 o 也套用同一范围（这一步是代码设定，不是数据限制）
.         keep if inrange(o, 11, 18) | inrange(o, 31, 35) | inrange(o, 51, 54)
 11.     }
 12.     gen byte hasw   = !missing(incwage) & incwage > 0 & incwage < 9999999
 13.     gen double m_w  = perwt
 14.     gen double wx_w = perwt*incwage if hasw
 15.     gen double wg_w = perwt if hasw
 16.     collapse (sum) m_w wx_w wg_w, by(o d)
 17.     rename m_w  m_od
 18.     rename wx_w wsum
 19.     rename wg_w wden
 20.     gen double wage_od = wsum/wden if wden > 0 & !missing(wden)
 21.     drop wsum wden
 22. 
.     bysort o: egen double pop_o  = total(m_od)
 23.     bysort d: egen double m_in_d = total(m_od)
 24.     egen double pop_all = total(m_od)
 25.     gen double pi_do = m_od/pop_o
 26. 
.     preserve
 27.         keep if o == d
 28.         keep o pi_do
 29.         rename pi_do pi_oo
 30.         tempfile go
 31.         save `go'
 32.         rename o d
 33.         rename pi_oo pi_dd
 34.         tempfile gd
 35.         save `gd'
 36.     restore
 37.     preserve
 38.         keep o d pi_do
 39.         rename o _t1
 40.         rename d _t2
 41.         rename _t1 d
 42.         rename _t2 o
 43.         rename pi_do pi_rev
 44.         tempfile rv
 45.         save `rv'
 46.     restore
 47. 
.     gen double pi_dnoto = (m_in_d - m_od)/(pop_all - pop_o) if (pop_all - pop_o) > 0
 48.     keep if o != d
 49.     merge m:1 o using `go', keep(master match) nogen
 50.     merge m:1 d using `gd', keep(master match) nogen
 51.     merge 1:1 o d using `rv', keep(master match) nogen
 52.     merge 1:1 o d using `dist25x', keep(master match) nogen
 53. 
.     keep if !missing(pi_do)     & pi_do     > 0
 54.     keep if !missing(pi_rev)    & pi_rev    > 0
 55.     keep if !missing(pi_oo)     & pi_oo     > 0
 56.     keep if !missing(pi_dd)     & pi_dd     > 0
 57.     keep if !missing(pi_dnoto)  & pi_dnoto  > 0
 58.     keep if !missing(dist_km)   & dist_km   > 0
 59.     gen double ln_p      = ln(pi_do)
 60.     gen double ln_pdnoto = ln(pi_dnoto)
 61.     gen double ln_wage   = ln(wage_od) if !missing(wage_od) & wage_od > 0
 62. end

. 
