. display "      固定 θ = 12.5，只变 ρ —— 看两个地点的抽签相关性"
      固定 θ = 12.5，只变 ρ —— 看两个地点的抽签相关性

. display ""


. display "        ρ      θ̃=θ(1−ρ)   皮尔逊相关    都进前25%的比例   斯皮尔曼秩相关"
        ρ      θ̃=θ(1−ρ)   皮尔逊相关    都进前25%的比例   斯皮尔曼秩相关

. display "  " "{hline 74}"
  --------------------------------------------------------------------------

. foreach rho in 0 0.3 0.5 0.74 0.9 0.99 {
  2.     quietly {
  3.         preserve
  4.         drop _all
  5.         set obs `NPER'
  6.         gen long pid = _n
  7.         local alp = 1 - `rho'
  8.         gen double uu = 3.14159265358979 * runiform()
  9.         gen double ww = -ln(runiform())
 10.         * alpha = 1 (即 rho = 0) 时 V 退化为常数 1，必须特判，
.         * 否则 0 * ln(sin(0)) = 0 * 缺失 = 缺失
.         if `alp' >= 1 {
 11.             gen double lnV = 0
 12.         }
 13.         else {
 14.             gen double lnV = ln(sin(`alp'*uu)) - (1/`alp')*ln(sin(uu)) ///
>                              + ((1-`alp')/`alp')*( ln(sin((1-`alp')*uu)) - ln(ww) )
 15.         }
 16.         drop uu ww
 17.         expand 2
 18.         bysort pid: gen byte loc = _n
 19.         gen double ln_u = (-1/`TH') * ln( -ln(runiform()) )
 20.         gen double s = exp(lnV/`TH' + ln_u)
 21.         keep pid loc s
 22.         reshape wide s, i(pid) j(loc)
 23.         quietly correlate s1 s2
 24.         local corr = r(rho)
 25.         quietly spearman s1 s2
 26.         local spr = r(rho)
 27.         quietly _pctile s1, p(75)
 28.         local c1 = r(r1)
 29.         quietly _pctile s2, p(75)
 30.         local c2 = r(r1)
 31.         quietly count if s1 > `c1' & s2 > `c2'
 32.         local both = r(N)/_N
 33.         restore
 34.     }
 35.     local ttv = `TH'*(1-`rho')
 36.     display "      " %5.2f `rho' "   " %9.3f `ttv' "      " %9.4f `corr' "       " %9.4f `both' "        " %9.4f `spr'
 37. }
