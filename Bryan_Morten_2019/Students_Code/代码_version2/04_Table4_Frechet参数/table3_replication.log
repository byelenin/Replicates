. *==============================================================================
. * 4. 估计程序 t3est
. *
. *    对当前数据集估计 theta（IV）、rho（式 8）、theta~、平均迁移成本（式 11）。
. *    不永久改动数据，可在 bootstrap 里反复调用。
. *
. *    解式(8) 用两段网格搜索（先粗后细），比一次性细网格快十几倍。
. *==============================================================================
. capture program drop t3est

. program define t3est, rclass
  1.     version 15
  2.     tempvar phat lhs tau
  3. 
.     * ---- (a) theta ----
.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
  4.     quietly predict double `phat', xb
  5. 
.     * 数据里如果有 year（美国一年以上时），必须加年份固定效应，
.     * 否则名义工资的跨年差异会被误当成迁移份额的作用，估计会崩。
.     capture confirm variable year
  6.     if _rc {
  7.         local yrfe ""
  8.     }
  9.     else {
 10.         local yrfe "i.year"
 11.     }
 12. 
.     capture quietly ivregress 2sls ln_wage (ln_p = `phat') i.o i.d `yrfe', cluster(o)
 13.     if _rc {
 14.         quietly ivregress 2sls ln_wage (ln_p = `phat') i.o i.d `yrfe'
 15.     }
 16.     local b = _b[ln_p]
 17. 
.     if missing(`b') | `b' >= 0 {
 18.         return scalar theta  = .
 19.         return scalar rho    = .
 20.         return scalar thetat = .
 21.         return scalar taubar = .
 22.         exit
 23.     }
 24.     local theta = -1/`b'
 25. 
.     * ---- (b) rho：式(8) 数值求解 theta~ ----
.     * 老师口径：v = pair 内个人工资的 CV^2，按 pair 人口加权
.     quietly summarize cv2_in [aw = npw]
 26.     local v = r(mean)
 27. 
.     local best  = .
 28.     local bestd = 1e30
 29.     forvalues i = 205/3000 {
 30.         local tt = `i'/100
 31.         local rhs = exp(lngamma(1 - 2/`tt'))/(exp(lngamma(1 - 1/`tt'))^2) - 1
 32.         local dd = abs(`rhs' - `v')
 33.         if `dd' < `bestd' {
 34.             local bestd = `dd'
 35.             local best  = `tt'
 36.         }
 37.     }
 38.     local c = `best'
 39.     local lo = `c' - 0.05
 40.     local hi = `c' + 0.05
 41.     forvalues i = 1/100 {
 42.         local tt = `lo' + (`i' - 1)*(`hi' - `lo')/99
 43.         local rhs = exp(lngamma(1 - 2/`tt'))/(exp(lngamma(1 - 1/`tt'))^2) - 1
 44.         local dd = abs(`rhs' - `v')
 45.         if `dd' < `bestd' {
 46.             local bestd = `dd'
 47.             local best  = `tt'
 48.         }
 49.     }
 50.     local thetat = `best'
 51.     local rho = 1 - `thetat'/`theta'
 52. 
.     * ---- (c) 平均迁移成本：式(11) ----
.     quietly gen double `lhs' = (ln_p - ln_poo) + (ln_p_rev - ln_pdd)
 53.     quietly gen double `tau' = 1 - exp(`lhs'/(2*`theta'))
 54.     quietly summarize `tau'
 55.     local taubar = r(mean)
 56. 
.     return scalar theta  = `theta'
 57.     return scalar rho    = `rho'
 58.     return scalar thetat = `thetat'
 59.     return scalar taubar = `taubar'
 60.     return scalar vwage  = `v'
 61. end

. 
. 
. *==============================================================================
. * 4b. Bootstrap 程序 t3boot
. *
. *     用内置 bootstrap 配 cluster() 在只有 17 个省时会报
. *     「insufficient observations to compute bootstrap standard errors」，
. *     所以这里自己做：按出发地【有放回】重抽样（bsample, cluster(o)），
. *     对每个重抽样样本重新估一遍，最后取有效次数的标准差。
. *     注意：重抽样的出发地仍用原来的 o 编号，所以固定效应结构不变。
. *==============================================================================
. capture program drop t3boot

. program define t3boot, rclass
  1.     version 15
  2.     local B = 200
  3.     matrix _BS = J(`B', 4, .)
  4.     capture drop bsid2
  5.     forvalues b = 1/`B' {
  6.         preserve
  7.         quietly bsample, cluster(o) idcluster(bsid2)
  8.         capture quietly t3est
  9.         if _rc == 0 {
 10.             matrix _BS[`b', 1] = r(theta)
 11.             matrix _BS[`b', 2] = r(rho)
 12.             matrix _BS[`b', 3] = r(thetat)
 13.             matrix _BS[`b', 4] = r(taubar)
 14.         }
 15.         restore
 16.     }
 17.     capture drop bs_1 bs_2 bs_3 bs_4
 18.     quietly svmat double _BS, names(bs_)
 19.     quietly count if !missing(bs_1)
 20.     local nvalid = r(N)
 21.     quietly summarize bs_1
 22.     local se_theta = r(sd)
 23.     quietly summarize bs_2
 24.     local se_rho = r(sd)
 25.     quietly summarize bs_3
 26.     local se_thetat = r(sd)
 27.     quietly summarize bs_4
 28.     local se_taubar = r(sd)
 29.     drop bs_1 bs_2 bs_3 bs_4
 30.     return scalar se_theta  = `se_theta'
 31.     return scalar se_rho    = `se_rho'
 32.     return scalar se_thetat = `se_thetat'
 33.     return scalar se_taubar = `se_taubar'
 34.     return scalar nvalid    = `nvalid'
 35. end

