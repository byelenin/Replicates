. * ============================================================
. * 方法三：还原绝对水平（归一化 q_1 = 1）
. * ============================================================
. display _n(2) "{hline 76}"


----------------------------------------------------------------------------

. display "方法三：用归一化 q_1 = 1 还原 w_d 和 q_o 的绝对水平"
方法三：用归一化 q_1 = 1 还原 w_d 和 q_o 的绝对水平

. display "{hline 76}"
----------------------------------------------------------------------------

. 
. quietly regress ln_wage ln_pi i.o i.d

. local c    = _b[_cons]

. local lnw1 = `c' - `lnG'

. 
. display _n "  d     ln(w_d)      w_d 还原     真实 w_d     误差"

  d     ln(w_d)      w_d 还原     真实 w_d     误差

. display "  {hline 54}"
  ------------------------------------------------------

. display "  1   " %10.4f `lnw1' "    " %8.4f exp(`lnw1') "     " %7.4f 1.00 " 
>    " %7.4f exp(`lnw1')-1.00
  1      -0.0230      0.9773      1.0000    -0.0227

. forvalues i = 2/4 {
  2.     local lnwi = `lnw1' + _b[`i'.d]
  3.     quietly summarize w_true if d == `i'
  4.     display "  `i'   " %10.4f `lnwi' "    " %8.4f exp(`lnwi') "     " %7.4
> f r(mean) "    " %7.4f exp(`lnwi')-r(mean)
  5. }
  2       0.4341      1.5436      1.5000     0.0436
  3      -0.2082      0.8120      0.8000     0.0120
  4       0.1953      1.2157      1.2000     0.0157

. 
. display _n "  o     ln(q_o)      q_o 还原     真实 q_o     误差"

  o     ln(q_o)      q_o 还原     真实 q_o     误差

. display "  {hline 54}"
  ------------------------------------------------------

. display "  1   " %10.4f 0 "    " %8.4f 1 "     " %7.4f 1.00 "    " %7.4f 0
  1       0.0000      1.0000      1.0000     0.0000

. forvalues i = 2/3 {
  2.     local lnqi = _b[`i'.o]
  3.     quietly summarize q_true if o == `i'
  4.     display "  `i'   " %10.4f `lnqi' "    " %8.4f exp(`lnqi') "     " %7.4
> f r(mean) "    " %7.4f exp(`lnqi')-r(mean)
  5. }
  2      -0.5113      0.5997      0.6000    -0.0003
  3       0.3325      1.3944      1.4000    -0.0056

. 
