. 
. quietly reghdfe ln_wage ln_pi, absorb(d o, savefe)

. display "  reghdfe 的 ln(π) 系数 = " %9.4f _b[ln_pi] "   （真实 -0.2000）"
  reghdfe 的 ln(π) 系数 =   -0.1984   （真实 -0.2000）

. display "  观测数 N = " e(N)
  观测数 N = 360

. 
. display _n "  savefe 造出来的变量："

  savefe 造出来的变量：

. capture describe __hdfe*, short

. if _rc == 0 {
.     display "  （存在）"
  （存在）
. }

. 
. display _n "  试各种 predict 写法："

  试各种 predict 写法：

. foreach opt in "d" "xbd" "xb" "residuals" {
  2.     capture drop _ft
  3.     capture predict double _ft, `opt'
  4.     display "    predict ..., " %-10s "`opt'" "  → rc = " _rc
  5. }
    predict ..., d           → rc = 9
    predict ..., xbd         → rc = 9
    predict ..., xb          → rc = 0
    predict ..., residuals   → rc = 9

. capture drop _ft

. 
. display _n "  取出固定效应的推荐写法（reghdfe 官方）："

  取出固定效应的推荐写法（reghdfe 官方）：

. capture predict double fe_d, d

. if _rc == 0 {
.     display "    predict fe_d, d 成功"
.     forvalues i = 1/4 {
  2.         quietly summarize fe_d if d == `i'
  3.         display "      d=`i'   fe_d = " %9.4f r(mean)
  4.     }
. }

. else {
.     display "    predict fe_d, d 返回 rc = " _rc
    predict fe_d, d 返回 rc = 9
.     display "    → 改用 savefe 生成的 __hdfe1__ / __hdfe2__ 变量"
    → 改用 savefe 生成的 __hdfe1__ / __hdfe2__ 变量
.     capture confirm variable __hdfe1__
.     if _rc == 0 {
.         display "    __hdfe1__（对应 absorb 里第一个变量 d）分城市均值："
    __hdfe1__（对应 absorb 里第一个变量 d）分城市均值：
.         forvalues i = 1/4 {
  2.             quietly summarize __hdfe1__ if d == `i'
  3.             display "      d=`i'   __hdfe1__ = " %9.4f r(mean)
  4.         }
      d=1   __hdfe1__ =   -0.1225
      d=2   __hdfe1__ =    0.3346
      d=3   __hdfe1__ =   -0.3078
      d=4   __hdfe1__ =    0.0958
.     }
.     capture confirm variable __hdfe2__
.     if _rc == 0 {
.         display "    __hdfe2__（对应 o）分出发地均值："
    __hdfe2__（对应 o）分出发地均值：
.         forvalues i = 1/3 {
  2.             quietly summarize __hdfe2__ if o == `i'
  3.             display "      o=`i'   __hdfe2__ = " %9.4f r(mean)
  4.         }
      o=1   __hdfe2__ =    0.0596
