. * ============================================================
. * 固定效应怎么算 —— 完整演示（修正版）
. * ============================================================
. clear all

. set more off

. set seed 20191029

. 
. set obs 360
Number of observations (_N) was 0, now 360.

. gen byte o = ceil(_n/120)

. gen byte d = 1 + floor(mod(_n-1,120)/30)      // ← 修正：d 从 1 开始

. 
. gen double w_true = .
(360 missing values generated)

. replace w_true = 1.00 if d == 1
(90 real changes made)

. replace w_true = 1.50 if d == 2
(90 real changes made)

. replace w_true = 0.80 if d == 3
(90 real changes made)

. replace w_true = 1.20 if d == 4
(90 real changes made)

. 
. gen double q_true = .
(360 missing values generated)

. replace q_true = 1.00 if o == 1
(120 real changes made)

. replace q_true = 0.60 if o == 2
(120 real changes made)

. replace q_true = 1.40 if o == 3
(120 real changes made)

. 
. gen double pi = 0.05 + 0.10*runiform()

. replace pi = pi + 0.02 if d == 2
(90 real changes made)

. replace pi = pi - 0.01 if o == 3
(120 real changes made)

. 
. local Gbar  = 0.9

. local theta = 5

. local lnG   = ln(`Gbar')

. 
. gen double ln_pi   = ln(pi)                   // ← 先算好变量，reghdfe 不认 l
> n(pi)

. gen double ln_wage = `lnG' + ln(w_true) - (1/`theta')*ln_pi + ///
>                      ln(q_true) + 0.15*rnormal()

. 
. display _n(2) "{hline 76}"


----------------------------------------------------------------------------

. display "真值：θ=5（系数 -0.2）；w_d = 1.00 / 1.50 / 0.80 / 1.20；q_o = 1.00 
> / 0.60 / 1.40"
真值：θ=5（系数 -0.2）；w_d = 1.00 / 1.50 / 0.80 / 1.20；q_o = 1.00 / 0.60 / 1.
> 40

. display "{hline 76}"
----------------------------------------------------------------------------

. 
. * ============================================================
. * 方法一：虚拟变量
. * ============================================================
. display _n(2) "{hline 76}"


----------------------------------------------------------------------------

. display "方法一：regress ln_wage ln_pi i.o i.d"
方法一：regress ln_wage ln_pi i.o i.d

. display "{hline 76}"
----------------------------------------------------------------------------

. quietly regress ln_wage ln_pi i.o i.d

. 
. display _n "  系数           估出来      真实值      差"

  系数           估出来      真实值      差

. display "  {hline 50}"
  --------------------------------------------------

. display "  ln(π)        " %9.4f _b[ln_pi] "   " %9.4f -1/`theta' "   " %9.4f 
> _b[ln_pi]+1/`theta'
  ln(π)          -0.1984     -0.2000      0.0016

. display "  2.d          " %9.4f _b[2.d]   "   " %9.4f ln(1.50) "   " %9.4f _b
> [2.d]-ln(1.50)
  2.d             0.4571      0.4055      0.0516

. display "  3.d          " %9.4f _b[3.d]   "   " %9.4f ln(0.80) "   " %9.4f _b
> [3.d]-ln(0.80)
  3.d            -0.1853     -0.2231      0.0379

. display "  4.d          " %9.4f _b[4.d]   "   " %9.4f ln(1.20) "   " %9.4f _b
