. local prev = .

. * 注意：theta~ <= 2 时 Gamma(1-2/theta~) 的自变量非正，公式失效（theta~ = 2 
> 是奇点）
. foreach tt in 2.2 2.5 2.69 3.0 3.18 3.5 4.0 5.0 8.0 12.5 27.6 {
  2.     local v = exp(lngamma(1 - 2/`tt'))/(exp(lngamma(1 - 1/`tt'))^2) - 1
  3.     if `prev' == . {
  4.         display "   " %6.2f `tt' "        " %12.5f `v'
  5.     }
  6.     else {
  7.         local chg = (`v' - `prev')/`prev'*100
  8.         display "   " %6.2f `tt' "        " %12.5f `v' "          " %8.1f 
> `chg' " %"
  9.     }
 10.     local prev = `v'
 11. }
