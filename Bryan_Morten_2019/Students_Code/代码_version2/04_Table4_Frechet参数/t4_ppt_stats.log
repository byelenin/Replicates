-------------------------------------------------------------------------------
> ---------

. 
. capture program drop solve_tt

. program define solve_tt, rclass
  1.     args target
  2.     local lo = 1.02
  3.     local hi = 80
  4.     forvalues i = 1/300 {
  5.         local mid = (`lo' + `hi')/2
  6.         local f = exp(lngamma(1 - 2/`mid'))/(exp(lngamma(1 - 1/`mid'))^2) 
> - 1
  7.         if `f' > `target' local lo = `mid'
  8.         else                local hi = `mid'
  9.     }
 10.     return scalar tt = (`lo' + `hi')/2
 11. end

. 
. display ""


. display "  样本          实际 var/wbar^2    反解 theta~    配套 theta     推
> 出 rho"
  样本          实际 var/wbar^2    反解 theta~    配套 theta     推出 rho

. 
. foreach pr in "IDN_main 0.16956 10.551" "IDN_paper 0.14089 12.4399" ///
>               "US_main 0.07879 41.130" "US_paper 0.05635 30.2548" {
  2.     local nm : word 1 of `pr'
  3.     local v  : word 2 of `pr'
  4.     local th : word 3 of `pr'
  5.     if "`nm'" == "IDN_main"  local full "印尼 1995 省级（对数 2SLS 基准）"
  6.     if "`nm'" == "IDN_paper" local full "印尼 论文口径（PPML+IV，丢 n_raw<
> 5）"
  7.     if "`nm'" == "US_main"   local full "美国 1990（对数 2SLS 基准）"
  8.     if "`nm'" == "US_paper"  local full "美国 1990 论文口径（PPML+IV，丢 n
> _raw<5）"
  9.     quietly solve_tt `v'
 10.     local tt = r(tt)
 11.     local rh = 1 - `tt'/`th'
 12.     display "  " %-36s "`full'" %12.5f `v' %13.4f `tt' %13.4f `th' %10.4f 
> `rh'
 13. }
