  2.     local nm : word 1 of `pr'
  3.     local b  : word 2 of `pr'
  4.     local se : word 3 of `pr'
  5.     local t  = `b'/`se'
  6.     local lo = `b' - 1.96*`se'
  7.     local hi = `b' + 1.96*`se'
