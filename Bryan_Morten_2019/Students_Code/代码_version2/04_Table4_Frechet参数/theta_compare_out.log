. *==============================================================================
. * 4. 子程序：把三种方法都跑一遍
. *==============================================================================
. capture program drop thetacmp

. program define thetacmp
  1.     args tag cl
  2.     display _n(2) "{hline 78}"
  3.     display "  【`tag'】"
  4.     display "{hline 78}"
  5. 
.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
  6.     local r2z = e(r2)
  7.     quietly predict double phat, xb
  8.     display "  零阶段 R² = " %6.4f `r2z'
  9. 
.     quietly count if !missing(ln_wage)
 10.     local n1 = r(N)
 11.     quietly capture ivregress 2sls ln_wage (ln_p = phat) i.o i.d, cluster(`cl')
 12.     if _rc == 0 {
 13.         local b1 = _b[ln_p]
 14.         if `b1' < 0 {
 15.             display "  ① 对数 2SLS + 虚拟变量：   β = " %10.6f `b1' "   θ = " %10.4f -1/`b1' "   N = `n1'"
 16.         }
 17.         else {
 18.             display "  ① 对数 2SLS + 虚拟变量：   β = " %10.6f `b1' "   θ 无解（β 为正）"
 19.         }
 20.     }
 21.     else {
 22.         display "  ① 对数 2SLS 失败，返回码 `=_rc'"
 23.     }
 24. 
.     quietly capture ppmlhdfe wage_od ln_p, absorb(o d) cluster(`cl')
 25.     if _rc == 0 {
 26.         local b2 = _b[ln_p]
 27.         local n2 = e(N)
 28.         if `b2' < 0 {
 29.             display "  ② PPML + 双向固定效应：    β = " %10.6f `b2' "   θ = " %10.4f -1/`b2' "   N = `n2'"
 30.         }
 31.         else {
 32.             display "  ② PPML + 双向固定效应：    β = " %10.6f `b2' "   θ 无解（β 为正）"
 33.         }
 34.     }
 35.     else {
 36.         display "  ② PPML 失败，返回码 `=_rc'"
 37.     }
 38. 
.     quietly capture reghdfe ln_p phat, absorb(o d) residuals(u)
 39.     if _rc == 0 {
 40.         quietly capture ppmlhdfe wage_od ln_p u, absorb(o d) cluster(`cl')
 41.         if _rc == 0 {
 42.             local b3 = _b[ln_p]
 43.             local n3 = e(N)
 44.             if `b3' < 0 {
 45.                 display "  ③ PPML + 控制函数 IV：      β = " %10.6f `b3' "   θ = " %10.4f -1/`b3' "   N = `n3'"
 46.             }
 47.             else {
 48.                 display "  ③ PPML + 控制函数 IV：      β = " %10.6f `b3' "   θ 无解（β 为正）"
 49.             }
 50.         }
 51.         else {
 52.             display "  ③ PPML 第二阶段失败，返回码 `=_rc'"
 53.         }
 54.     }
 55.     else {
 56.         display "  ③ 第一阶段 reghdfe 失败，返回码 `=_rc'"
 57.     }
 58. end

. 
