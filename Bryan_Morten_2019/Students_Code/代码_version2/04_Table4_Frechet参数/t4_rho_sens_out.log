. display "  样本                                  实际 var/w̄²   反解 θ̃   论文 θ̃"
  样本                                  实际 var/w̄²   反解 θ̃   论文 θ̃

. display "  " "{hline 74}"
  --------------------------------------------------------------------------

. foreach row in "IDN_main 0.91808 3.18" "IDN_paper 0.93472 3.18" "US_main 0.61290 2.69" "US_paper 0.61307 2.69" {
  2.     local nm  : word 1 of `row'
  3.     local var = real("`: word 2 of `row''")
  4.     local ttp = real("`: word 3 of `row''")
  5.     * 二分法：找 θ̃ 使式(8) 右端 = 观测到的方差
.     scalar lo = 2.0001
  6.     scalar hi = 300
  7.     forvalues it = 1/200 {
  8.         scalar mid = (lo+hi)/2
  9.         scalar cmid = exp(lngamma(1 - 2/mid) - 2*lngamma(1 - 1/mid)) - 1
 10.         if cmid > `var' {
 11.             scalar lo = mid
 12.         }
 13.         else {
 14.             scalar hi = mid
 15.         }
 16.     }
 17.     scalar tth = (lo+hi)/2
 18.     * 论文 θ̃ 对应的方差
.     scalar lnp = lngamma(1 - 2/`ttp') - 2*lngamma(1 - 1/`ttp')
 19.     scalar varp = exp(lnp) - 1
 20.     scalar ratio = varp/`var'
 21.     if "`nm'" == "IDN_main"  local full "印尼 1995 省级 · 主口径（对数 2SLS）"
 22.     if "`nm'" == "IDN_paper" local full "印尼 1995 省级 · 论文口径（PPML+IV）"
 23.     if "`nm'" == "US_main"   local full "美国 1990 · 主口径（对数 2SLS）"
 24.     if "`nm'" == "US_paper"  local full "美国 1990 · 论文口径（PPML+IV）"
 25.     display "  " %-34s "`full'" %11.5f `var' "  " %8.4f tth "  " %6.2f `ttp'
 26.     display "        论文 θ̃ 隐含的方差 = " %9.5f varp " ，是我们实际测到的 " %7.3f ratio " 倍"
 27. }
