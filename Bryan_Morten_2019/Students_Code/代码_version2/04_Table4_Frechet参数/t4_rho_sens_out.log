. display "  θ̃       d ln(CV²)/d ln(θ̃)    工资方差偏高 1% → θ̃ 变动"
  θ̃       d ln(CV²)/d ln(θ̃)    工资方差偏高 1% → θ̃ 变动

. display "  " "{hline 70}"
  ----------------------------------------------------------------------

. local h = 0.00001

. foreach tt in 2.2 2.5 2.69 3.18 3.5 4.0874 4.3692 5.4671 6.2753 8 12.5 27.6 {
  2.     scalar t = `tt'
  3.     scalar tup = t*(1+`h')
  4.     scalar tdn = t*(1-`h')
  5.     scalar cup = exp(lngamma(1 - 2/tup) - 2*lngamma(1 - 1/tup)) - 1
  6.     scalar cdn = exp(lngamma(1 - 2/tdn) - 2*lngamma(1 - 1/tdn)) - 1
  7.     scalar elas = (ln(cup) - ln(cdn)) / (ln(1+`h') - ln(1-`h'))
  8.     * d ln(θ̃) = (1/elas)·d ln(CV²)；d ln(CV²)=0.01 时的百分比变化 = 100*0.01/elas = 1/elas
.     scalar invp = 1/elas
  9.     display "  " %7.4f t "       " %10.4f elas "            " %7.3f invp " %"
 10. }
