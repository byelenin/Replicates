. * ---------- 4. π_do ----------
. preserve

.     gen double n = perwt

.     collapse (sum) n, by(o d)

.     bysort o: egen n_o = total(n)

.     gen double p_od = n / n_o

. 
.     bysort o: egen p_check = total(p_od)

.     quietly summarize p_check

.     display _n "  【检查】π_do 按出生县加总：最小 = " %6.4f r(min) ///
