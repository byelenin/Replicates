file idn_regency_dist.dta saved

. 
. *---- 1. 载入 1995 年（只读需要的 7 个变量）----
. use year geo2_id1995 id1995a_bplreg incwage perwt relate sex age using "D:\研
> 一上\微观计量\ipumsi_00002.dta", clear

. keep if year == 1995
(23,603,049 observations deleted)

. count
  718,837

. display "  ^ 1995 年总人数（论文 Table 2 的样本年份）"
  ^ 1995 年总人数（论文 Table 2 的样本年份）

. 
. *---- 2. 统一县码 ----
. *  出生县码是 1101 这种 4 位，现居县码是 11001 这种 5 位，必须先转换
. *  int(x/100)*1000 取省，mod(x,100) 取县，拼起来
. gen long o = int(id1995a_bplreg/100)*1000 + mod(id1995a_bplreg,100)

. gen long d = geo2_id1995

. 
. *==============================================================
. * 3. π_od：迁移份额
. *    分子 = 出生在 o、现居在 d 的加权人数
. *    分母 = 所有出生在 o 的加权人数
. *==============================================================
. display _n "===== 3a. π_od（全部人）====="

===== 3a. π_od（全部人）=====

. preserve

.     collapse (sum) n = perwt, by(o d)

.     bysort o: egen double n_o = total(n)

.     gen double p_od = n / n_o

.     bysort o: egen double chk = total(p_od)

.     quietly summarize chk

.     display "  【自检】π_od 按出生县 o 加总：最小 = " %9.6f r(min) "  最大 = 
> " %9.6f r(max)
  【自检】π_od 按出生县 o 加总：最小 =  1.000000  最大 =  1.000000

.     keep o d p_od n

.     tempfile pop_all

.     save "`pop_all'"
file C:\Users\任娜\AppData\Local\Temp\ST_88c0_000002.tmp saved as .dta format

. restore

. 
. display _n "===== 3b. π_od（男性户主 15-65 岁）====="

===== 3b. π_od（男性户主 15-65 岁）=====

. preserve

.     keep if relate == 1 & sex == 1 & age >= 15 & age <= 65
(583,784 observations deleted)

.     count
  135,053

.     display "  ^ 男性户主 15-65 岁人数"
  ^ 男性户主 15-65 岁人数

.     collapse (sum) n = perwt, by(o d)

.     bysort o: egen double n_o = total(n)

.     gen double p_od_mh = n / n_o

.     rename n n_mh

.     keep o d p_od_mh n_mh

.     tempfile pop_mh

.     save "`pop_mh'"
file C:\Users\任娜\AppData\Local\Temp\ST_88c0_000004.tmp saved as .dta format

. restore

. 
. *==============================================================
. * 4. wage_od：平均月工资
. *    分子 = Σ(perwt × incwage)
. *    分母 = Σ perwt
. *    incwage 缺失码：9999998 = UNKNOWN，9999999 = NIU（没问过）
. *==============================================================
. display _n "===== 4a. wage_od（全部有工资的人）====="

===== 4a. wage_od（全部有工资的人）=====

. preserve

.     keep if incwage > 0 & incwage < 9999990
(612,215 observations deleted)

.     count
  106,622

.     display "  ^ 有有效工资的人数"
  ^ 有有效工资的人数

.     gen double ww = perwt * incwage

.     collapse (sum) ww perwt, by(o d)

.     rename perwt n_wage

.     gen double wage_od = ww / n_wage

.     keep o d wage_od n_wage

.     tempfile wag_all

.     save "`wag_all'"
file C:\Users\任娜\AppData\Local\Temp\ST_88c0_000006.tmp saved as .dta format

. restore

. 
. display _n "===== 4b. wage_od（男性户主 15-65 岁）====="

===== 4b. wage_od（男性户主 15-65 岁）=====

. preserve

.     keep if incwage > 0 & incwage < 9999990 & relate == 1 & sex == 1 & age >=
>  15 & age <= 65
(668,637 observations deleted)

.     count
  50,200

.     display "  ^ 有有效工资的男性户主 15-65 岁"
  ^ 有有效工资的男性户主 15-65 岁

.     gen double ww = perwt * incwage

.     collapse (sum) ww perwt, by(o d)

.     rename perwt n_wage_mh

.     gen double wage_od_mh = ww / n_wage_mh

.     keep o d wage_od_mh n_wage_mh

.     tempfile wag_mh

.     save "`wag_mh'"
file C:\Users\任娜\AppData\Local\Temp\ST_88c0_000008.tmp saved as .dta format

. restore

