. local root "D:\研一上\微观计量"

. 
. capture program drop _both

. program define _both
  1.     args dep rhs wt useif vn lab cl
  2.     local wo ""
  3.     if "`wt'" != "NONE" local wo "[aw=`wt']"
  4.     local uf ""
  5.     if "`useif'" != "ALL" local uf "`useif'"
  6.     capture quietly reghdfe `dep' `rhs' `wo' `uf', absorb(o d) vce(cluster `cl')
  7.     local b = _b[`vn']
  8.     local s = _se[`vn']
  9.     local flag ""
 10.     if missing(`s') | `s' <= 0 {
 11.         capture quietly reghdfe `dep' `rhs' `wo' `uf', absorb(o d) vce(cluster o)
 12.         local s = _se[`vn']
 13.         local flag "   [VCV非正定 → 改 cluster(o)]"
 14.     }
 15.     local t = `b'/`s'
 16.     local st ""
 17.     if abs(`t') > 2.576      local st "***"
 18.     else if abs(`t') > 1.96  local st "**"
 19.     else if abs(`t') > 1.645 local st "*"
 20.     display "   `lab'   b = " %10.4f `b' "   SE = " %9.4f `s' "   t = " %8.2f `t' "  `st'`flag'"
 21. end

