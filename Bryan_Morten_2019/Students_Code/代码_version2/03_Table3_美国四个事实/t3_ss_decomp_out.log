. 
. * (A) 围绕 0
. gen double ss0 = x^2

. quietly summarize ss0

. local A = r(sum)

. 
. * (B) 围绕总均值
. quietly summarize x

. local xb = r(mean)

. gen double ssT = (x - `xb')^2

. quietly summarize ssT

. local B = r(sum)

. 
. * (C) 围绕「出发州×年」组均值
. bysort oyear: egen double mo = mean(x)

. gen double ssO = (x - mo)^2

. quietly summarize ssO

. local C = r(sum)

. * 组间（出发州×年）
. gen double ssB1 = (mo - `xb')^2

. quietly summarize ssB1

. local B1 = r(sum)

. 
. * (D) 围绕「目的州×年」组均值
. bysort dyear: egen double md = mean(x)

. gen double ssD = (x - md)^2

. quietly summarize ssD

. local D = r(sum)

. gen double ssB2 = (md - `xb')^2

. quietly summarize ssB2

. local B2 = r(sum)

. 
. * (E) 双向迭代去均值
. gen double xt = x

. forvalues k = 1/250 {
  2.     quietly bysort oyear: egen double _q = mean(xt)
  3.     quietly replace xt = xt - _q
  4.     quietly drop _q
  5.     quietly bysort dyear: egen double _q = mean(xt)
  6.     quietly replace xt = xt - _q
  7.     quietly drop _q
  8. }

. gen double ss2 = xt^2

. quietly summarize ss2

. local E = r(sum)

