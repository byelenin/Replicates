  6.     if `n' == 2 local cd "if !missing(ln_wage)"
  7.     if `n' == 3 local rv "ln_p"
  8.     if `n' == 3 local cd "if !missing(ln_wage)"
  9.     display "     [dep=`dv'  reg=`rv'  `cd']"
