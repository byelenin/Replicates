. foreach yy in 1976 1995 {
  2.     display _n "===================== `yy' 年 ====================="
  3. 
.     display _n "--- (1) Fact 1  ln π 对 ln 距离 ---"
  4.     reghdfe ln_p ln_dist if year == `yy', absorb(o d) cluster(o d)
  5.     local b1_`yy' = _b[ln_dist]
  6.     local s1_`yy' = _se[ln_dist]
  7.     local n1_`yy' = e(N)
  8. 
.     display _n "--- (2) Fact 2  ln w 对 ln 距离 ---"
  9.     reghdfe ln_wage ln_dist if year == `yy', absorb(o d) cluster(o d)
 10.     local b2_`yy' = _b[ln_dist]
 11.     local s2_`yy' = _se[ln_dist]
 12.     local n2_`yy' = e(N)
 13. 
.     display _n "--- (3) Fact 3  ln w 对 ln π ---"
 14.     reghdfe ln_wage ln_p if year == `yy', absorb(o d) cluster(o d)
 15.     local b3_`yy' = _b[ln_p]
 16.     local s3_`yy' = _se[ln_p]
 17.     local n3_`yy' = e(N)
 18. 
.     display _n "--- (4) Fact 4  ln w 对 ln π 与 ln 距离 ---"
 19.     reghdfe ln_wage ln_p ln_dist if year == `yy', absorb(o d) cluster(o d)
 20.     local b4p_`yy' = _b[ln_p]
 21.     local s4p_`yy' = _se[ln_p]
 22.     local b4d_`yy' = _b[ln_dist]
 23.     local s4d_`yy' = _se[ln_dist]
 24.     local n4_`yy' = e(N)
 25. }

