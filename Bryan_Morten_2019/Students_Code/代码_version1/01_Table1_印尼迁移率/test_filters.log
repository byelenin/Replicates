file C:\Users\任娜\AppData\Local\Temp\ST_927c_000008.tmp saved as .dta format

. 
. capture program drop thetafull

. program define thetafull, rclass
  1.     quietly regress ln_p c.ln_pdnoto##c.ln_pdnoto
  2.     quietly predict double _ph, xb
  3.     quietly capture ivregress 2sls ln_wage (ln_p = _ph) i.o i.d, cluster(o
> )
  4.     if _rc {
  5.         quietly ivregress 2sls ln_wage (ln_p = _ph) i.o i.d
  6.     }
  7.     local b = _b[ln_p]
  8.     return scalar N = e(N)
  9.     if `b' >= 0 {
 10.         return scalar theta = .
 11.         exit
 12.     }
 13.     local theta = -1/`b'
 14.     return scalar theta = `theta'
 15.     quietly summarize wage_od
 16.     local vm = r(Var)/(r(mean)^2)
 17.     local best = .
 18.     local bezt = .
 19.     forvalues tt = 200/4000 {
 20.         local t = `tt'/100
 21.         local g1 = lngamma(1 - 1/`t')
 22.         local g2 = lngamma(1 - 2/`t')
 23.         if `g2' < . {
 24.             local d = abs(exp(`g2' - 2*`g1') - 1 - `vm')
 25.             if `best' == . | `d' < `best' {
 26.                 local best = `d'
 27.                 local bezt = `t'
 28.             }
 29.         }
 30.     }
 31.     return scalar thetat = `bezt'
 32.     return scalar rho    = 1 - `bezt'/`theta'
 33.     return scalar vm     = `vm'
 34. end

