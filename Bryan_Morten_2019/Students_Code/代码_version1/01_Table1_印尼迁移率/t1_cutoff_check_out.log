. display "{hline 84}"
------------------------------------------------------------------------------------

. quietly summarize perwt

. local tot = r(sum)

. display "     Σ perwt（全部人口，加权）= " %16.0fc `tot'
     Σ perwt（全部人口，加权）=      166,522,373

. 
. foreach u in 1 2 {
  2.     quietly summarize perwt if urban == `u'
  3.     local s`u' = r(sum)
  4.     local p`u' = `s`u''/`tot'*100
  5.     display "     urban==`u' 的 Σ perwt = " %16.0fc `s`u'' "   = " %6.2f `p`u'' "%"
  6. }
     urban==1 的 Σ perwt =      104,398,440   =  62.69%
     urban==2 的 Σ perwt =       62,123,933   =  37.31%

. display ""


