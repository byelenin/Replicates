. display "  ④ 县级农村占比 → 规则 A / 规则 B 的切点（复算）"
  ④ 县级农村占比 → 规则 A / 规则 B 的切点（复算）

. display "{hline 84}"
------------------------------------------------------------------------------------

. preserve

.     gen double wrur1 = perwt*(urban == 1)

.     gen double wrur2 = perwt*(urban == 2)

.     collapse (sum) wpop = perwt wrur1 wrur2, by(geo2_id1995)

.     gen double rs1 = wrur1/wpop

.     gen double rs2 = wrur2/wpop

.     quietly summarize wpop

.     local tp = r(sum)

.     quietly summarize wrur1

.     local n1 = r(sum)/`tp'

.     quietly summarize wrur2

.     local n2 = r(sum)/`tp'

.     display "     县数 = " _N
     县数 = 221

.     display "     以 urban==1 为农村：全国农村占比 = " %6.2f `n1'*100 "%"
     以 urban==1 为农村：全国农村占比 =  62.69%

.     display "     以 urban==2 为农村：全国农村占比 = " %6.2f `n2'*100 "%"
     以 urban==2 为农村：全国农村占比 =  37.31%

.     display ""


.     foreach k in 1 2 {
  2.         quietly summarize rs`k', detail
  3.         local med`k' = r(p50)
  4.         gsort -rs`k'
  5.         gen double cs`k' = sum(wpop)/`tp'
  6.         gen long ord`k' = _n
  7.         local tgt = `n`k''
  8.         quietly summarize ord`k' if cs`k' >= `tgt', meanonly
  9.         local kA = r(min)
 10.         local cutA = rs`k'[`kA']
 11.         quietly count if rs`k' > `cutA'
 12.         local nR = r(N)
 13.         display "     口径 `k'：中位数 = " %6.4f `med`k'' ///
>             " ；规则A 切点 = " %6.4f `cutA' " → 农村县 `nR' 个"
 14.     }
     口径 1：中位数 = 0.7817 ；规则A 切点 = 0.6663 → 农村县 145 个
     口径 2：中位数 = 0.2183 ；规则A 切点 = 0.3337 → 农村县 75 个

. restore

