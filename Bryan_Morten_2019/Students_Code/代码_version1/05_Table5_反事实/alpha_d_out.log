. * 式(8)：由工资方差反解 θ̃
. quietly summarize wage_od

. local v = r(Var)/(r(mean)^2)

. display "  工资均值 = " %14.2f r(mean) "   方差 = " %18.2f r(Var)
  工资均值 =      320955.59   方差 =     18161909997.70

. display "  var(w)/w̄² = " %10.5f `v'
  var(w)/w̄² =    0.17631

. local best  = .

. local bestd = 1e30

. forvalues i = 205/4000 {
  2.     local tt = `i'/100
  3.     local rhs = exp(lngamma(1 - 2/`tt'))/(exp(lngamma(1 - 1/`tt'))^2) - 1
  4.     if abs(`rhs' - `v') < `bestd' {
  5.         local bestd = abs(`rhs' - `v')
  6.         local best  = `tt'
  7.     }
  8. }

. local c  = `best'

. local lo = `c' - 0.05

. local hi = `c' + 0.05

. forvalues i = 1/200 {
  2.     local tt = `lo' + (`i' - 1)*(`hi' - `lo')/199
  3.     local rhs = exp(lngamma(1 - 2/`tt'))/(exp(lngamma(1 - 1/`tt'))^2) - 1
  4.     if abs(`rhs' - `v') < `bestd' {
  5.         local bestd = abs(`rhs' - `v')
  6.         local best  = `tt'
  7.     }
  8. }

. local tt   = `best'

. local rho  = 1 - `tt'/`th'

. display _n "  θ̃ = " %8.4f `tt' "   ρ = 1 − θ̃/θ = " %8.4f `rho'

  θ̃ =   4.0318   ρ = 1 − θ̃/θ =   0.6796

