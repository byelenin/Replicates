. gen double xd = ln_dist

. gen double yd = ln_p

. forvalues k = 1/250 {
  2.     foreach v in xd yd {
  3.         quietly bysort oyear: egen double _q = mean(`v')
  4.         quietly replace `v' = `v' - _q
  5.         quietly drop _q
  6.         quietly bysort dyear: egen double _q = mean(`v')
  7.         quietly replace `v' = `v' - _q
  8.         quietly drop _q
  9.     }
 10. }

. quietly summarize xd if !missing(yd)

. local SXX = r(N)*r(Var)

. local MY  = r(N)

. display _n "  样本：`MY' 个州对（o≠d 且有观测工资）"

  样本：5000 个州对（o≠d 且有观测工资）

