. foreach v in ln_dist ln_p ln_wage {
  2.     quietly summarize `v'
  3.     local TOT  = r(Var)*(r(N)-1)
  4.     local MEAN = r(mean)
  5.     local nm = cond("`v'"=="ln_dist", "ln 距离 (x)", cond("`v'"=="ln_p", "ln 份额 (y)", "ln 工资 (y)"))
  6.     foreach g in oyear dyear {
  7.         capture drop _mg _dev _bt
  8.         quietly bysort `g': egen double _mg = mean(`v')
  9.         quietly gen double _dev = (`v' - _mg)^2
 10.         quietly gen double _bt  = (_mg - `MEAN')^2
 11.         quietly summarize _dev
 12.         local WIN = r(sum)
 13.         quietly summarize _bt
 14.         local BET = r(sum)
 15.         local lab = cond("`g'"=="oyear", "出发州×年", "目的州×年")
 16.         display "  " %-16s "`nm'" %-12s "`lab'" %11.2f `TOT' " " %11.2f `WIN' "  " %6.2f 100*`WIN'/`TOT' " %  " %10.2f `BET' "  " %6.2f 100*`BET'/`TOT' " %"
 17.     }
 18. }
