. 
. capture program drop _both

. program define _both
  1.     args dep rhs wt useif vn lab
  2.     local wo ""
  3.     if "`wt'" != "NONE" local wo "[aw=`wt']"
  4.     local uf ""
  5.     if "`useif'" != "ALL" local uf "`useif'"
  6.     capture quietly reghdfe `dep' `rhs' `wo' `uf', absorb(oyear dyear) vce(cluster oyear dyear)
  7.     local b = _b[`vn']
  8.     local s = _se[`vn']
  9.     local flag ""
 10.     if missing(`s') | `s' <= 0 {
 11.         capture quietly reghdfe `dep' `rhs' `wo' `uf', absorb(oyear dyear) vce(cluster oyear)
 12.         local s = _se[`vn']
 13.         local flag "   [二维VCV非正定 → 改一维聚类 cluster(oyear)]"
 14.     }
 15.     local t = `b'/`s'
 16.     local st ""
 17.     if abs(`t') > 2.576      local st "***"
 18.     else if abs(`t') > 1.96  local st "**"
 19.     else if abs(`t') > 1.645 local st "*"
 20.     display "   `lab'   b = " %10.4f `b' "   SE = " %9.4f `s' "   t = " %8.2f `t' "  `st'`flag'"
 21. end

. 
. capture program drop _block

. program define _block
  1.     args pan tag wt yf
  2.     display _n "  ===== 口径：`tag' ====="
  3.     use `pan', clear
  4.     if "`yf'" != "NONE" keep if year == `yf'
  5.     _both ln_p    "ln_dist"      "`wt'" "ALL"                  ln_dist "    (1) ln_dist → ln p "
  6.     _both ln_wage "ln_dist"      "`wt'" "if !missing(ln_wage)" ln_dist "    (2) ln_dist → ln w "
  7.     _both ln_wage "ln_dist ln_p" "`wt'" "if !missing(ln_wage)" ln_dist "    (3) ln_dist → ln w "
  8.     _both ln_wage "ln_dist ln_p" "`wt'" "if !missing(ln_wage)" ln_p    "    (3) ln_p    → ln w "
  9.     _both ln_wage "ln_p"         "`wt'" "if !missing(ln_wage)" ln_p    "    (4) ln_p    → ln w "
 10. end

