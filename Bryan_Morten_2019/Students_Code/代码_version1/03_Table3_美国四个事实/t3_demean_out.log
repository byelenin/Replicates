. gen double y2 = ln_p

. gen double x2 = ln_dist

. forvalues k = 1/250 {
  2.     quietly bysort oyear: egen double _a = mean(y2)
  3.     quietly replace y2 = y2 - _a
  4.     quietly drop _a
  5.     quietly bysort dyear: egen double _a = mean(y2)
  6.     quietly replace y2 = y2 - _a
  7.     quietly drop _a
  8.     quietly bysort oyear: egen double _z1 = mean(x2)
  9.     quietly replace x2 = x2 - _z1
 10.     quietly drop _z1
 11.     quietly bysort dyear: egen double _z1 = mean(x2)
 12.     quietly replace x2 = x2 - _z1
 13.     quietly drop _z1
 14. }

