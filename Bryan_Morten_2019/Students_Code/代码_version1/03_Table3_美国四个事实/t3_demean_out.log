file C:\Users\任娜\AppData\Local\Temp\dsh-MdbEjc\ST_1a78_000003.tmp saved as .dta format

. use `c_o', clear

. cross using `c_d'

. gen double _pio = _pi/180

. gen double _dla = (lat_d - lat_o)*_pio

. gen double _dlo = (lon_d - lon_o)*_pio

. gen double _a = sin(_dla/2)^2 + cos(lat_o*_pio)*cos(lat_d*_pio)*sin(_dlo/2)^2

. gen double dist_km = 2*6371*asin(min(1, sqrt(_a)))

. keep o d dist_km

. tempfile usdist

. save `usdist'
file C:\Users\任娜\AppData\Local\Temp\dsh-MdbEjc\ST_1a78_000004.tmp saved as .dta format

